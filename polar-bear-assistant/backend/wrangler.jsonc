{
  "name": "midea-ai-assistant",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "vars": {
    "ALLOWED_ORIGIN": "https://cindyyang0912kc-alt.github.io",
    "OPENAI_MODEL": "gpt-5-mini",
    "REALTIME_MODEL": "gpt-realtime-2.1"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
